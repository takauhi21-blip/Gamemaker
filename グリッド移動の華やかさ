//タイマーが動いている間の処理に挟めば一応動くコードです。
if(_draw_x!=x){
	       // 2. スピードは1以上
    var _speed = 2; 
	
     // 4. 行き過ぎ防止チェック（近くなったら目標値にする）
    if (abs(x - _draw_x) <= _speed) {
        _draw_x = x;
    }else{
    // 3. ローカル変数側を変化させる
    _draw_x += sign(x - _draw_x) * _speed;
	}
   
    // 5. 【超重要】計算が終わった最終的な値を、元のメンバ変数に上書きする！
    draw_x = _draw_x; 
}

if (draw_y != y) {
   
    // 2. スピードは1以上
    var _speed = 2; 
	
     // 4. 行き過ぎ防止チェック（近くなったら目標値にする）
    if (abs(y - _draw_y) <= _speed) {
        _draw_y = y;
    }else{
    // 3. ローカル変数側を変化させる
    _draw_y += sign(y - _draw_y) * _speed;
	}
   
    // 5. 【超重要】計算が終わった最終的な値を、元のメンバ変数に上書きする！
    draw_y = _draw_y; 
      }
